/* ═══════════════════════════════════════════════════════════
   TUNERPRO GLOBAL STYLESHEET
   Applied via QApplication::setStyleSheet()
   Specific widget styles follow in their respective sections.
   ═══════════════════════════════════════════════════════════ */

/* Base: everything on the darkest void */
QWidget {
    background-color: #07080A;
    color: #D8E4EE;
    font-family: "Inter", "Segoe UI", system-ui, sans-serif;
    font-size: 13px;
    font-weight: 400;
    border: none;
    outline: none;
    selection-background-color: #00C8A045;
    selection-color: #D8E4EE;
}

/* ── SCROLL BARS ── */
QScrollBar:vertical {
    background: transparent;
    width: 8px;
    margin: 0;
    border: none;
}
QScrollBar::handle:vertical {
    background: #2B3D50;
    min-height: 30px;
    border-radius: 4px;
    margin: 0 2px;
}
QScrollBar::handle:vertical:hover {
    background: #3C5268;
}
QScrollBar::add-line:vertical,
QScrollBar::sub-line:vertical,
QScrollBar::add-page:vertical,
QScrollBar::sub-page:vertical {
    background: transparent;
    border: none;
    height: 0;
    width: 0;
}
QScrollBar:horizontal {
    background: transparent;
    height: 8px;
    margin: 0;
}
QScrollBar::handle:horizontal {
    background: #2B3D50;
    min-width: 30px;
    border-radius: 4px;
    margin: 2px 0;
}
QScrollBar::handle:horizontal:hover {
    background: #3C5268;
}

/* ── TOOLTIPS ── */
QToolTip {
    background-color: #1F2630;
    color: #D8E4EE;
    border: 1px solid #2B3D50;
    border-radius: 4px;
    padding: 6px 10px;
    font-family: "Inter";
    font-size: 12px;
}

/* ── MENU BAR (if visible) ── */
QMenuBar {
    background-color: #07080A;
    color: #7D96AD;
    border-bottom: 1px solid #131A22;
    padding: 0;
}
QMenuBar::item {
    padding: 6px 12px;
    background: transparent;
}
QMenuBar::item:selected {
    background: #262F3C;
    color: #D8E4EE;
}

/* ── MENUS ── */
QMenu {
    background-color: #1F2630;
    color: #D8E4EE;
    border: 1px solid #2B3D50;
    border-radius: 8px;
    padding: 6px 0;
}
QMenu::item {
    padding: 7px 16px;
    font-size: 13px;
}
QMenu::item:selected {
    background-color: #262F3C;
    color: #D8E4EE;
}
QMenu::separator {
    height: 1px;
    background: #1D2A36;
    margin: 4px 0;
}

/* ── SPLITTERS ── */
QSplitter::handle {
    background: #131A22;
    width: 1px;
    height: 1px;
}
QSplitter::handle:hover {
    background: #2B3D50;
}

/* ── DIALOG BASE ── */
QDialog {
    background-color: #0C0F13;
    border: 1px solid #2B3D50;
    border-radius: 8px;
}

/* ── HEADER BAR (Consolidated) ── */
#HeaderBar {
    background-color: #07080A;
    border-bottom: 1px solid #131A22;
    min-height: 48px;
    max-height: 48px;
}

/* App name */
#TitleBarAppName {
    font-family: "Barlow Condensed";
    font-size: 15px;
    font-weight: 600;
    color: #D8E4EE;
    letter-spacing: 0.05em;
    padding-right: 8px;
}

/* Project name pill */
#ProjectNamePill {
    background-color: #181D24;
    border: 1px solid #1D2A36;
    border-radius: 12px;
    padding: 0 12px;
    min-height: 24px;
    max-height: 24px;
    font-family: "Barlow Condensed";
    font-size: 12px;
    font-weight: 500;
    color: #7D96AD;
}

#ProjectNamePill[unsaved="true"] {
    border-color: #00C8A045;
    color: #00C8A0;
}

/* COM Port / Read-Write Dropdown */
#ComPortSelector {
    background-color: #181D24;
    border: 1px solid #1D2A36;
    border-radius: 6px;
    color: #D8E4EE;
    font-family: "Inter";
    font-size: 12px;
    padding: 0 10px;
    min-height: 32px;
    max-height: 32px;
    min-width: 120px;
}
#ComPortSelector:hover {
    border-color: #2B3D50;
    background-color: #1D2A36;
}

/* Traffic light buttons */
#TitleBarClose, #TitleBarMinimize, #TitleBarMaximize {
    min-width: 12px;
    max-width: 12px;
    min-height: 12px;
    max-height: 12px;
    border-radius: 6px;
    background-color: #2B3D50;
    border: none;
    margin: 0 2px;
}

#HeaderBar:hover #TitleBarClose { background-color: #EF4444; }
#HeaderBar:hover #TitleBarMinimize { background-color: #EAB308; }
#HeaderBar:hover #TitleBarMaximize { background-color: #22C55E; }

/* COM Port selector */
#ComPortSelector {
    background-color: #181D24;
    border: 1px solid #1D2A36;
    border-radius: 4px;
    color: #7D96AD;
    font-family: "JetBrains Mono", monospace;
    font-size: 11px;
    padding: 0 8px 0 8px;
    min-height: 28px;
    max-height: 28px;
    min-width: 110px;
}
#ComPortSelector:hover {
    border-color: #2B3D50;
    color: #D8E4EE;
}
#ComPortSelector:focus {
    border-color: #3C5268;
}
#ComPortSelector::drop-down {
    width: 18px;
    border: none;
}

/* ECU Status pill */
#EcuStatusPill {
    background-color: #181D24;
    border: 1px solid #1D2A36;
    border-radius: 14px;
    min-height: 28px;
    max-height: 28px;
    padding: 0 12px;
    font-family: "Inter";
    font-size: 11px;
    font-weight: 500;
    color: #435870;
    letter-spacing: 0.10em;
    text-transform: uppercase;
}
#EcuStatusPill[connected="true"] {
    background-color: #00C8A012;
    border-color: #00C8A045;
    color: #00C8A0;
}
#EcuStatusPill[connected="false"] {
    background-color: #181D24;
    border-color: #1D2A36;
    color: #435870;
}

/* Live tuning toggle */
#LiveTuningToggle {
    background-color: #181D24;
    border: 1px solid #1D2A36;
    border-radius: 14px;
    min-height: 28px;
    max-height: 28px;
    padding: 0 12px;
    font-family: "Inter";
    font-size: 11px;
    font-weight: 500;
    color: #435870;
    letter-spacing: 0.10em;
    text-transform: uppercase;
}
#LiveTuningToggle[active="true"] {
    background-color: rgba(234, 179, 8, 0.09);
    border-color: rgba(234, 179, 8, 0.4);
    color: #EAB308;
}

/* Connect button */
#ConnectButton {
    background-color: #00C8A0;
    color: #07080A;
    border: none;
    border-radius: 6px;
    min-height: 28px;
    max-height: 28px;
    padding: 0 14px;
    font-family: "Inter";
    font-size: 13px;
    font-weight: 500;
}
#ConnectButton:hover {
    background-color: #00FFD0;
}
#ConnectButton:pressed {
    background-color: #00A883;
}
#ConnectButton[connected="true"] {
    background-color: transparent;
    border: 1px solid #00C8A045;
    color: #00C8A0;
}
#ConnectButton[connected="true"]:hover {
    background-color: #00C8A012;
    border-color: #00C8A0;
}

/* Save button */
#SaveButton {
    background-color: transparent;
    color: #7D96AD;
    border: 1px solid #2B3D50;
    border-radius: 6px;
    min-height: 28px;
    max-height: 28px;
    padding: 0 12px;
    font-family: "Inter";
    font-size: 13px;
}
#SaveButton:hover {
    color: #D8E4EE;
    border-color: #3C5268;
    background-color: #262F3C;
}
#SaveButton[hasChanges="true"] {
    color: #D8E4EE;
    border-color: #3C5268;
}
#SaveButton[hasChanges="false"] {
    color: #435870;
    border-color: #1D2A36;
}

/* Settings icon button */
#SettingsIconButton {
    background-color: transparent;
    border: none;
    color: #435870;
    min-width: 32px;
    max-width: 32px;
    min-height: 32px;
    max-height: 32px;
    border-radius: 4px;
    font-size: 16px;
}
#SettingsIconButton:hover {
    color: #D8E4EE;
    background-color: #262F3C;
}

/* ── NAVIGATION TAB BAR ── */
#MainTabWidget::pane {
    border: none;
    background-color: #0C0F13;
}
#MainTabWidget::tab-bar {
    left: 0;
    background-color: #0C0F13;
    border-bottom: 1px solid #131A22;
}
#MainTabWidget QTabBar::tab {
    background-color: transparent;
    color: #435870;
    font-family: "Barlow Condensed";
    font-size: 14px;
    font-weight: 500;
    padding: 0 22px;
    min-height: 38px;
    max-height: 38px;
    border: none;
    border-bottom: 2px solid transparent;
    letter-spacing: 0.02em;
}
#MainTabWidget QTabBar::tab:hover:!selected {
    color: #7D96AD;
    background-color: #262F3C;
}
#MainTabWidget QTabBar::tab:selected {
    color: #D8E4EE;
    background-color: #111519;
    border-bottom: 2px solid #00C8A0;
}

/* ── STATUS BAR ── */
#StatusBar {
    background-color: #07080A;
    border-top: 1px solid #131A22;
    min-height: 28px;
    max-height: 28px;
    padding: 0 16px;
}

/* Individual status field label (RPM:, MAP:, etc.) */
#StatusBar .FieldLabel {
    font-family: "Inter";
    font-size: 10px;
    font-weight: 500;
    color: #435870;
    text-transform: uppercase;
    letter-spacing: 0.04em;
}

/* Individual status field value */
#StatusBar .FieldValue {
    font-family: "JetBrains Mono", monospace;
    font-size: 10px;
    color: #7D96AD;
}

/* Divider between status fields */
#StatusBar .FieldDivider {
    color: #1D2A36;
    font-size: 10px;
    padding: 0 6px;
}

/* Value states — applied programmatically via dynamic property */
#StatusBar .FieldValue[alert="warn"]   { color: #EAB308; }
#StatusBar .FieldValue[alert="danger"] { color: #EF4444; }
#StatusBar .FieldValue[alert="safe"]   { color: #22C55E; }
#StatusBar .FieldValue[alert="info"]   { color: #38BDF8; }

/* ═════════ APPLIED FIX 5 (Global QSS Override) ═════════ */
QMainWindow, QDialog {
    background-color: #03050D;
}
QTabWidget::pane {
    background-color: #080E1C;
    border: 1px solid #1A2640;
}
QTabBar::tab {
    background: #080E1C;
    color: #7A8FAD;
    padding: 8px 20px;
    border: none;
    font-family: 'DM Sans', 'Segoe UI', sans-serif;
    font-size: 13px;
    letter-spacing: 0.05em;
}
QTabBar::tab:selected {
    color: #EEF2FF;
    border-bottom: 2px solid #00E5C8;
    background: #0F1829;
}
QTabBar::tab:hover:!selected {
    color: #B0C0D8;
    background: #0A1220;
}
QHeaderView::section {
    background-color: #0F1829;
    color: #7A8FAD;
    border: none;
    border-right: 1px solid #1A2640;
    border-bottom: 1px solid #1A2640;
    padding: 6px 10px;
    font-family: 'JetBrains Mono', 'Courier New', monospace;
    font-size: 11px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
}
QPushButton {
    background-color: #1A2640;
    color: #EEF2FF;
    border: 1px solid #1E2E4A;
    padding: 8px 20px;
    font-family: 'DM Sans', 'Segoe UI', sans-serif;
    font-size: 13px;
}
QPushButton:hover {
    background-color: #00E5C810;
    border-color: #00E5C8;
    color: #00E5C8;
}
QPushButton#connectBtn {
    background-color: #00E5C8;
    color: #03050D;
    font-weight: 600;
    border: none;
}
QPushButton#connectBtn:hover {
    background-color: #00FFE0;
}
QLabel {
    color: #7A8FAD;
    font-family: 'DM Sans', 'Segoe UI', sans-serif;
}
QScrollBar:vertical {
    background: #080E1C;
    width: 6px;
    border: none;
}
QScrollBar::handle:vertical {
    background: #1A2640;
    border-radius: 3px;
    min-height: 30px;
}
QScrollBar::handle:vertical:hover {
    background: #00E5C840;
}
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    height: 0px;
}